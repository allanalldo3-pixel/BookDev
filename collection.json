{
  "info": {
    "name": "DevBooks API",
    "description": "Requests ordered to create an author and book, list books, update the created book, and delete it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Criar Autor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Autor criado', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const author = pm.response.json();",
              "  pm.collectionVariables.set('authorId', author.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"J.K. Rowling {{$guid}}\",\n  \"biography\": \"Autora britânica, criadora de Harry Potter.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/authors"
      }
    },
    {
      "name": "2. Criar Livro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Livro criado', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const book = pm.response.json();",
              "  pm.collectionVariables.set('bookId', book.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Harry Potter e a Pedra Filosofal\",\n  \"release_year\": 1997,\n  \"author_id\": \"{{authorId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "3. Listar Livros",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Livros listados', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "4. Atualizar Livro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Livro atualizado', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Harry Potter e a Câmara Secreta\",\n  \"release_year\": 1998\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "5. Excluir Livro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Livro excluído', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3333" },
    { "key": "authorId", "value": "" },
    { "key": "bookId", "value": "" }
  ]
}