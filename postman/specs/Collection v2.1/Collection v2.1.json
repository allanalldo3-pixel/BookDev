{
  "openapi": "3.0.0",
  "info": {
    "title": "Collection v2.1",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "http://localhost:3333"
    }
  ],
  "paths": {
    "/authors": {
      "post": {
        "summary": "1. Criar Autor",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "biography": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "name": "J.K. Rowling",
                "biography": "Autora britânica, criadora de Harry Potter."
              }
            }
          }
        }
      }
    },
    "/books": {
      "post": {
        "summary": "2. Criar um Livro",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "release_year": {
                    "type": "integer"
                  },
                  "author_id": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "title": "Harry Potter e a Pedra Filosofal",
                "release_year": 1997,
                "author_id": "ee93d2ed-7510-4c45-8c07-3e985e1552df"
              }
            }
          }
        }
      },
      "get": {
        "summary": "3. Listar Livros",
        "responses": {}
      }
    },
    "/books/{bookId}": {
      "put": {
        "summary": "4. Atualizar Livro",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "release_year": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "title": "Harry Potter e a Câmara Secreta",
                "release_year": 1998
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "bookId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "{{bookId}}"
        }
      ],
      "delete": {
        "summary": "5. Excluir Livro",
        "responses": {}
      }
    }
  }
}